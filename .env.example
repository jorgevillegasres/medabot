# Copiar a apps/web/.env.local y completar con los datos del proyecto Supabase
# (Project Settings → API). La anon key es pública por diseño: la seguridad la imponen las
# políticas RLS de supabase/migrations. NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
