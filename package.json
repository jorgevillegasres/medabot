{
  "name": "medalab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @medalab/web dev",
    "build": "pnpm --filter @medalab/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:extract": "node scripts/extract-content.mjs",
    "e2e": "pnpm --filter @medalab/web e2e",
    "fixtures": "node scripts/make-fixtures.mjs",
    "seed": "node scripts/make-seed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.0.0"
  }
}
